    "./GcpClient": {
      "types": "./package/GcpClient.d.ts",
      "default": "./package/GcpClient.js"
    },
    "./canvasApi": {
      "types": "./package/canvasApi.d.ts",
      "default": "./package/canvasApi.js"
    },
    "./canvasSubscription": {
