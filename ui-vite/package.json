{
  "name": "canvas-ui",
  "version": "0.0.1",
  "description": "A P2P paint app for Urbit",
  "scripts": {
    "dev": "vite --port 4000 --host",
    "build": "svelte-kit build",
    "preview": "svelte-kit preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write ./src/**/*.{js,svelte,html,ts}",
    "lint": "eslint './src/**/*.{js,ts,svelte}'",
    "lint:fix": "eslint --fix './src/**/*.{js,ts,svelte}'",
    "prelint": "npm run format"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^2.2.0",
    "@holium/vite-plugin-urbit": "^0.8.0",
    "@aws-sdk/client-s3": "3.18.0",
    "@aws-sdk/s3-request-presigner": "3.18.0",
    "@observablehq/runtime": "4.12.0",
    "@sveltejs/adapter-static": "1.0.0-next.13",
    "@sveltejs/kit": "next",
    "@types/cookie": "^0.4.0",
    "@types/topojson": "3.2.3",
    "@typescript-eslint/eslint-plugin": "^4.19.0",
    "@typescript-eslint/parser": "^4.19.0",
    "@urbit/api": "^2.1.0",
    "@urbit/http-api": "^2.1.0",
    "any-ascii": "0.2.0",
    "buffer": "^6.0.3",
