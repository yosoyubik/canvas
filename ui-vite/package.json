      ],
      "mousing": [
        "./package/mousing.d.ts"
      ],
      "topology": [
        "./package/topology.d.ts"
      ],
      "urbit/api": [
        "./package/urbit/api.d.ts"
      ],
      "urbit/subscription": [
        "./package/urbit/subscription.d.ts"
      ],
      "utils": [
        "./package/utils.d.ts"
      ]
    }
